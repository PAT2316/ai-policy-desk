# ── Base de données (Hostinger MySQL) ──────────────────────────────
DATABASE_URL="mysql://user:password@localhost:3306/ai_policy_desk"

# ── Authentification ────────────────────────────────────────────────
AUTH_SECRET="changeme-generate-with-openssl-rand-base64-32"
APP_URL="https://app.example.com"
ENCRYPTION_KEY="changeme-generate-with-openssl-rand-base64-32"

# ── Email (ADR-005 : Brevo au MVP) ──────────────────────────────────
EMAIL_PROVIDER="console"   # "console" en dev, "brevo" en production
BREVO_API_KEY=""

# ── Stockage documentaire (ADR-004 : Cloudflare R2) ─────────────────
R2_ENDPOINT=""             # https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# ── Intelligence artificielle (ADR-006 : Claude au MVP) ─────────────
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""

# ── Paiement (Stripe) ────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Tâches planifiées (ADR-007 : cron Hostinger) ────────────────────
CRON_SECRET="changeme-generate-with-openssl-rand-base64-32"
